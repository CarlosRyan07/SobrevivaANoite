{
  "name": "sobreviva-a-noite-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "assets:optimize": "node scripts/optimize-assets.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "visual:check": "npm run build && node scripts/visual-check.mjs",
    "pwa:check": "npm run build && node scripts/pwa-check.mjs"
  },
  "dependencies": {
    "@fontsource/bungee": "^5.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.8.0",
    "jsdom": "30.0.1",
    "puppeteer-core": "^25.4.0",
    "sharp": "^0.35.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.2.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10"
  }
}
